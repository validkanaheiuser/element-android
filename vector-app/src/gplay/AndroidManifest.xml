<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
    Installing an APK from inside the app is an F-Droid / nightly only feature, and Google Play
    restricts REQUEST_INSTALL_PACKAGES to app stores, file managers and browsers. Remove it from
    the Play build so the release does not require a Sensitive app permission declaration.
    -->
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />

    <!--
    jitsi-meet-sdk pulls in react-native-calendar-events, which declares the calendar permissions
    for the Jitsi app's own "upcoming meetings" tab. Aero never surfaces that screen, so the
    permissions would only show up on the Play listing as unexplained Calendar access.
    -->
    <uses-permission
        android:name="android.permission.READ_CALENDAR"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.WRITE_CALENDAR"
        tools:node="remove" />

    <application>

        <!-- Firebase components -->
        <meta-data
            android:name="firebase_analytics_collection_deactivated"
            android:value="true" />

        <!-- Add tools:ignore="Instantiatable" for the error reported only by the CI :/ -->
        <service android:name="im.vector.app.push.fcm.VectorFirebaseMessagingService"
            android:exported="false"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
